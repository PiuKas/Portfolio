---
import { CV } from '../../i18n/routes.mjs';
---
<section class="ab-sobre" id="sobre-mi">
  <div class="ab-container">
    <div class="ab-head">
      <h2 class="ab-h2">Sobre mí y contacto<span class="ab-dot">.</span></h2>
      <p class="ab-section-label"><span class="ab-num-accent">(06)</span> — SOBRE MÍ</p>
    </div>
    <div class="ab-duo">
      <div class="ab-duo__card">
        <p class="ab-duo__label">Sobre mí</p>
        <p class="ab-duo__title">Más de 4 años diseñando producto digital.</p>
        <a class="ab-sobre__cv" href={CV.es} download>Descargar CV (PDF) ↓</a>
      </div>
      <div class="ab-duo__card ab-duo__card--contact" id="contacto">
        <p class="ab-duo__label">Contacto</p>
        <p class="ab-duo__title">¿Hablamos?</p>
        <p class="ab-duo__text">Si tienes un puesto o un proyecto en mente, escríbeme.</p>
        <p class="ab-contacto__mail"><a href="mailto:andreapwyt@gmail.com?subject=Hola%20Andrea" id="ab-mail">andreapwyt@gmail.com</a></p>
        <div class="ab-contacto__ctas">
          <a class="ab-btn-dark" href="mailto:andreapwyt@gmail.com?subject=Hola%20Andrea">Enviar un email</a>
          <button class="ab-btn-outline ab-contacto__copy" type="button" id="ab-copy" data-mail="andreapwyt@gmail.com">Copiar email</button>
          <span class="ab-contacto__ok" id="ab-copy-ok" role="status" aria-live="polite"></span>
        </div>
      </div>
    </div>
  </div>
</section>

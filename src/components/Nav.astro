---
import LangSwitch from './LangSwitch.astro';
import { CV } from '../i18n/routes.mjs';
---
<header class="ab-nav">
  <div class="ab-container ab-nav__inner">
    <a class="ab-nav__logo" href="/" aria-label="Andrea Blanco, inicio" id="ab-logo">AB<span>.</span></a>
    <nav class="ab-nav__links" aria-label="Navegación principal">
      <a href="/#proyectos">Proyectos</a>
      <a href="/#experiencia">Experiencia</a>
      <a href="/#que-hago" class="chg">Qué hago</a>
      <a href="/#ia">IA</a>
      <a href="/#contacto">Contacto</a>
      <span class="ab-nav__sep"></span>
      <LangSwitch />
      <a class="ab-nav__cta" href={CV.es} download>CV ↓</a>
    </nav>
    <button class="ab-nav__burger" id="ab-burger" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="ab-panel"><span aria-hidden="true">≡</span></button>
  </div>
  <div class="ab-nav__panel" id="ab-panel">
    <a href="/#proyectos">Proyectos</a>
    <a href="/#experiencia">Experiencia</a>
    <a href="/#que-hago">Qué hago</a>
    <a href="/#ia">IA</a>
    <a href="/#contacto">Contacto</a>
    <LangSwitch panel />
    <a class="ab-nav__panel-cta" href={CV.es} download>Descargar CV ↓</a>
  </div>
</header>

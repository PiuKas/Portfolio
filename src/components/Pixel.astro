<aside class="ab-pal" id="ab-pal" aria-label="Pixel, asistente del portfolio">
  <button class="ab-pal__btn" id="ab-pal-btn" type="button" aria-expanded="false" aria-controls="ab-pal-card" aria-label="Preguntas sobre Andrea">
    <canvas class="ab-pal__cv" id="ab-pal-cv" width="80" height="80"></canvas>
  </button>
  <div class="ab-pal__card" id="ab-pal-card">
    <button class="ab-pal__close" id="ab-pal-close" type="button" aria-label="Cerrar burbuja"><svg viewBox="0 0 10 10" aria-hidden="true"><path d="M1 1l8 8M9 1l-8 8"/></svg></button>
    <p class="ab-pal__msg" id="ab-pal-msg" aria-live="polite">¡Hola! Soy Pixel. Si tienes prisa, te cuento en 30 segundos por qué Andrea encaja en tu equipo.</p>
    <div class="ab-pal__qs" id="ab-pal-qs">
      <button type="button" data-q="why">¿Qué la diferencia de otros perfiles de producto?</button>
      <button type="button" data-q="dev">¿Cómo trabaja con Producto y desarrollo?</button>
      <button type="button" data-q="ai">¿Cómo usa la IA de verdad?</button>
      <button type="button" data-q="a11y">¿Cuida la accesibilidad?</button>
      <button type="button" data-q="next">¿Cómo sigo?</button>
    </div>
    <div class="ab-pal__foot">
      <button class="ab-pal__more" id="ab-pal-more" type="button">Pregúntame</button>
      <button class="ab-pal__hide" id="ab-pal-hide" type="button" aria-label="Ocultar a Pixel">Ocultar</button>
    </div>
  </div>
</aside>

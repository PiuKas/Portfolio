---
import Base from '../layouts/Base.astro';
---
<Base
  title="Página no encontrada - Andrea Blanco"
  description="Esta página no existe."
  noindex
>
  <main class="ab-404">
    <div class="ab-container">
      <p class="ab-section-label"><span class="ab-num-accent">404</span> - Página no encontrada</p>
      <h1 class="ab-404__title">Esta página no existe<span class="ab-dot">.</span></h1>
      <p class="ab-404__text">Puede que el enlace sea de la versión anterior de la web. Todo lo que había está en la home.</p>
      <p class="ab-404__text ab-404__text--en" lang="en">This page doesn't exist. Everything from the previous site is on the home page.</p>
      <div class="ab-404__ctas">
        <a class="ab-btn-dark" href="/">Ir al inicio</a>
        <a class="ab-btn-outline" href="/en/" lang="en">English site</a>
      </div>
    </div>
  </main>
</Base>

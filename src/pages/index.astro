---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Pixel from '../components/Pixel.astro';
import Hero from '../components/home/Hero.astro';
import Proyectos from '../components/home/Proyectos.astro';
import Experiencia from '../components/home/Experiencia.astro';
import QueHago from '../components/home/QueHago.astro';
import Proceso from '../components/home/Proceso.astro';
import IA from '../components/home/IA.astro';
import Sobre from '../components/home/Sobre.astro';
---
<Base
  home
  title="Andrea Blanco - Product Builder"
  description="Product Builder. Encuentro dónde se atasca un producto o un equipo y construyo la forma de quitar esa fricción, del problema a producción, con la IA en todo el proceso."
>
  <Intro slot="before-nav" />
  <main id="top">
    <Hero />
    <Proceso />
    <IA />
    <Experiencia />
    <Proyectos />
    <QueHago />
    <Sobre />
  </main>
  <Pixel slot="after-footer" />
</Base>
